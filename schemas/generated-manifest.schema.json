{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/k4nul/devops-stack-composer/schemas/generated-manifest.schema.json",
  "title": "DevOps Stack generated-file manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "generatedAt",
    "configHash",
    "outputDirectory",
    "templates",
    "environments",
    "validation",
    "files"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "toolVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outputDirectory": {"type": "string", "minLength": 1},
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker", "jenkins", "kubernetes"],
      "properties": {
        "docker": {"$ref": "#/definitions/template"},
        "jenkins": {"$ref": "#/definitions/template"},
        "kubernetes": {"$ref": "#/definitions/template"}
      }
    },
    "environments": {
      "type": "array",
      "items": {"enum": ["dev", "staging", "production"]},
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "counts"],
      "properties": {
        "passed": {"type": "boolean"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "PASSED",
            "FAILED",
            "SKIPPED_MISSING_OPTIONAL_TOOL",
            "BLOCKED_MISSING_REQUIRED_TOOL"
          ],
          "properties": {
            "PASSED": {"type": "integer", "minimum": 0},
            "FAILED": {"type": "integer", "minimum": 0},
            "SKIPPED_MISSING_OPTIONAL_TOOL": {"type": "integer", "minimum": 0},
            "BLOCKED_MISSING_REQUIRED_TOOL": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {"$ref": "#/definitions/file"}
    }
  },
  "definitions": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "adapterVersion"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "adapterVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode", "origins"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
        "origins": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
